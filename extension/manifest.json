{
  "manifest_version": 3,
  "name": "Article Depot",
  "version": "1.1.0",
  "description": "Send the article you are reading to the Article Depot library: option potential, food for thought, or pass.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send this article to Article Depot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "articledepot@example.com",
      "strict_min_version": "115.0"
    }
  }
}
